# Starts robot-head on boot. pi/install.sh fills in the user, folder and uv, and installs it as
# /etc/systemd/system/robot-head.service. Logs: journalctl -u robot-head -f
[Unit]
Description=robot-head, an LLM-driven animatronic head
Wants=network-online.target user@@UID@.service
After=network-online.target sound.target user@@UID@.service

[Service]
User=@USER@
WorkingDirectory=@DIR@
# On desktop images sound goes through the user's PipeWire, which lives here.
Environment=XDG_RUNTIME_DIR=/run/user/@UID@
ExecStart=@UV@ run --frozen --extra pi python -m robot_head
# Ctrl+C rather than a hard stop, so the servos are let go and the devices closed properly.
KillSignal=SIGINT
TimeoutStopSec=15
Restart=on-failure
RestartSec=5
SupplementaryGroups=audio video i2c gpio

[Install]
WantedBy=multi-user.target
