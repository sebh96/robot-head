# Copy this file to .env and fill in your key: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Any OpenRouter model that accepts images. Fast and cheap works best for conversation.
OPENROUTER_MODEL=anthropic/claude-haiku-5.5
# Thinking before answering adds delay: none, low, medium or high (not every model accepts none).
# With Haiku 5.5 and a camera frame, none started replying after ~1 s; low took 3-6 s.
# Leave empty to use the model's default.
REASONING_EFFORT=none

# Pick the camera, microphone and speaker interactively with: uv run python -m robot_head --choose-devices
CAMERA_INDEX=0
# Set to true if the head turns away from you instead of toward you
CAMERA_FLIP=false
# Attach the current camera frame to every message; this is how the head "sees"
SEND_CAMERA_FRAMES=true

# Speech recognition: parakeet (accurate and fast, 25 European languages, detects the language itself)
# or whisper (many more languages, but much slower on a CPU)
STT_ENGINE=parakeet
# Model for that engine; empty = its default (nemo-parakeet-tdt-0.6b-v3, or Whisper small)
STT_MODEL=
# Whisper only: language code such as en or de. Empty makes Whisper guess on every phrase, which is slower and error-prone
STT_LANGUAGE=
# Whisper only: cpu, or cuda if CUDA 12 and cuDNN 9 are installed
STT_DEVICE=cpu
# Save every phrase it hears to recordings/ (audio plus what it understood), to track down recognition problems
SAVE_RECORDINGS=false
# Microphone and speaker: part of the device name (see --list-devices); empty = system default
MIC_DEVICE=
SPEAKER_DEVICE=
# How long a pause ends your turn, in seconds
SILENCE_SECONDS=0.8

# Voice engine: kokoro sounds most natural; piper is faster and lighter and has more languages (German too)
TTS_ENGINE=kokoro
# Voice for that engine (uv run python -m robot_head --list-voices); empty = the engine's default.
# Kokoro male voices: am_michael, am_fenrir, am_puck, am_adam, am_echo, am_eric, am_liam, am_onyx (US),
# bm_george, bm_daniel, bm_fable, bm_lewis (UK). Piper: en_US-bryce-medium, German de_DE-thorsten-medium
TTS_VOICE=am_michael
# 1.0 = normal, 1.2 = 20% faster
TTS_SPEED=1.1

# The name it answers to is set per personality in the control panel.
# After it answers, keep listening without the name for this many seconds
FOLLOW_UP_SECONDS=20
# Make an unprompted remark when it sees someone and nobody spoke for this many seconds (0 = never).
# Every ignored remark doubles the wait.
REMARK_AFTER_SECONDS=45
# Let people interrupt it by talking over it (its own voice is removed with echo cancellation)
BARGE_IN=true

# sim = only shown in the control panel, pca9685 = real servos on a Raspberry Pi as well
MOTORS=sim

# The control panel (personalities, expressions, all of these settings) at http://WEB_HOST:WEB_PORT
WEB_UI=true
WEB_PORT=8765
# 127.0.0.1 = this computer only. 0.0.0.0 opens it to your network, API key included: trusted networks only
WEB_HOST=127.0.0.1
